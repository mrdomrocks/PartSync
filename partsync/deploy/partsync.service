[Unit]
Description=PartSync stock monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# deploy/install.sh writes this file with the real user and paths.
# The git clone is ~/PartSync. The Next.js app, database, and build are ~/PartSync/partsync.
# Do not set WorkingDirectory to a folder named partsync that itself contains partsync/.
User=pi
WorkingDirectory=/home/pi/PartSync/partsync
Environment=NODE_ENV=production
EnvironmentFile=-/home/pi/PartSync/partsync/.env.local
ExecStart=/usr/bin/node /home/pi/PartSync/partsync/node_modules/next/dist/bin/next start --hostname 0.0.0.0 --port 4747
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
