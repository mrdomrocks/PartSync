# Copy to .env.local. Values here override the Setup screen.
# Leave a line blank, or delete it, to edit that setting in the browser.

# DATABASE_PATH=data/partsync.db
# PARTSYNC_SITE_NAME=Workshop stores
# PARTSYNC_TIME_ZONE=Europe/London
# PARTSYNC_PUBLIC_URL=http://192.168.1.20:4747
# PARTSYNC_NOTIFY_EMAIL=stores@example.com
# PARTSYNC_SMTP_HOST=smtp.example.com
# PARTSYNC_SMTP_PORT=587
# PARTSYNC_SMTP_SECURE=starttls
# PARTSYNC_SMTP_USER=
# PARTSYNC_SMTP_PASS=
# PARTSYNC_SMTP_FROM=stores@example.com
